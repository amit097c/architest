{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Debug server.py",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "console": "integratedTerminal",
            "args": [
                "llm.server:app",  // Change this based on your entry file
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/llm/server.py"
            },
            "jinja": true,
            "justMyCode": true
        }
    ]
}
